// =============================================================================
//  SignageCMS — Prisma Schema
//  Source of truth cho cấu trúc DB. Dùng để tạo migrations, KHÔNG dùng PrismaClient.
//
//  KIẾN TRÚC DB:
//  ┌─────────────────────────────────────────────────────────────────────────┐
//  │  Prisma CLI (prisma)   →  tạo + apply migrations                       │
//  │  PrismaClient          →  KHÔNG DÙNG ở runtime (binary không chạy trên │
//  │                            Windows host; dùng raw `pg` driver thay thế) │
//  │  pg driver             →  tất cả runtime queries trong src/             │
//  └─────────────────────────────────────────────────────────────────────────┘
//
//  WORKFLOW MIGRATION:
//    1. Sửa schema này
//    2. npx prisma migrate dev --name <tên>   ← tạo file SQL migration
//    3. Review file SQL trong prisma/migrations/
//    4. npx prisma migrate deploy             ← apply lên DB
//
//  KHÔNG BAO GIỜ:
//    - import PrismaClient vào runtime code
//    - dùng prisma db push (bỏ qua migration history)
// =============================================================================

generator client {
  // Generator được giữ lại để `prisma migrate` hoạt động.
  // PrismaClient được tạo ra nhưng KHÔNG được import trong src/.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  MULTI-TENANCY
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  settings          Json?
  isActive          Boolean  @default(true)
  maxDevices        Int      @default(10)
  maxUsers          Int      @default(5)
  storageQuotaBytes BigInt   @default(10737418240)
  pkg12m            Int      @default(0)
  pkg24m            Int      @default(0)
  pkg36m            Int      @default(0)
  deviceAdminPin    String   @default("0000")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users            User[]
  devices          Device[]
  deviceGroups     DeviceGroup[]
  media            Media[]
  playlists        Playlist[]
  schedules        Schedule[]
  stores           Store[]
  deviceLicenses   DeviceLicense[]
  licenseHistories LicenseHistory[]
  purchaseRequests PurchaseRequest[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
//  USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(uuid())
  organizationId String
  email          String     @unique
  passwordHash   String
  role           UserRole   @default(MANAGER)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media        Media[]

  @@index([organizationId])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ─────────────────────────────────────────────────────────────────────────────
//  DEVICES
// ─────────────────────────────────────────────────────────────────────────────

model Device {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  location       String?
  timezone       String       @default("Asia/Ho_Chi_Minh")
  pairingCode    String?
  androidId      String?      @unique
  model          String?
  osVersion      String?
  appVersion     String?
  status         DeviceStatus @default(OFFLINE)
  isLicensed       Boolean      @default(true)
  licenseExpiresAt DateTime?
  lastSeen         DateTime?
  lastOfflineAt    DateTime?
  settings         Json?
  storeId          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupMembers   DeviceGroupMember[]
  playbackLogs   PlaybackLog[]
  healthReports  DeviceHealth[]
  comments       DeviceComment[]
  store          Store?              @relation(fields: [storeId], references: [id], onDelete: SetNull)
  deviceLicense  DeviceLicense?
  licenseHistory LicenseHistory[]

  @@index([organizationId, status])
  @@index([lastSeen])
  @@index([storeId])
  @@map("devices")
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  ERROR
}

model DeviceGroup {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      DeviceGroupMember[]
  schedules    Schedule[]

  @@index([organizationId])
  @@map("device_groups")
}

model DeviceGroupMember {
  deviceId String
  groupId  String

  device Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  group  DeviceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([deviceId, groupId])
  @@map("device_group_members")
}

// ─────────────────────────────────────────────────────────────────────────────
//  MEDIA CONTENT
// ─────────────────────────────────────────────────────────────────────────────

model Media {
  id             String      @id @default(uuid())
  organizationId String
  uploadedById   String
  title          String
  description    String?
  type           MediaType
  filePath       String
  fileSize       BigInt
  mimeType       String
  fileHash       String      // SHA-256 của file — dùng để detect thay đổi
  duration       Int?        // giây, cho video
  width          Int?
  height         Int?
  thumbnailPath  String?
  tags           String[]
  metadata       Json?
  status         MediaStatus @default(PROCESSING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  playlistItems PlaylistItem[]
  playbackLogs  PlaybackLog[]

  @@index([organizationId, type, status])
  @@index([fileHash])
  @@map("media")
}

enum MediaType {
  VIDEO
  IMAGE
  HTML
  URL
}

enum MediaStatus {
  PROCESSING
  READY
  ERROR
}

// ─────────────────────────────────────────────────────────────────────────────
//  PLAYLISTS
// ─────────────────────────────────────────────────────────────────────────────

model Playlist {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  isDefault       Boolean  @default(false)
  isAutoGenerated Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PlaylistItem[]
  schedules    Schedule[]
  stores       Store[]

  @@index([organizationId])
  @@map("playlists")
}

model PlaylistItem {
  id               String  @id @default(uuid())
  playlistId       String
  mediaId          String
  position         Int
  durationOverride Int?    // override media duration (giây)
  transition       String? // fade, slide, ...

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([playlistId, position])
  @@map("playlist_items")
}

// ─────────────────────────────────────────────────────────────────────────────
//  SCHEDULES
// ─────────────────────────────────────────────────────────────────────────────

model Schedule {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  playlistId     String
  targetType     ScheduleTarget
  targetDeviceId String?
  targetGroupId  String?
  startDate      DateTime
  endDate        DateTime?
  startTime      String?        // "08:00" — 24h
  endTime        String?        // "18:00" — 24h
  daysOfWeek     Int[]          // [1,2,3,4,5] Mon=1 … Sun=7
  priority       Int            @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playlist     Playlist     @relation(fields: [playlistId], references: [id])
  deviceGroup  DeviceGroup? @relation(fields: [targetGroupId], references: [id])

  @@index([organizationId, isActive])
  @@index([startDate, endDate])
  @@map("schedules")
}

enum ScheduleTarget {
  ALL
  DEVICE
  GROUP
}

// ─────────────────────────────────────────────────────────────────────────────
//  ANALYTICS
// ─────────────────────────────────────────────────────────────────────────────

model PlaybackLog {
  id             String   @id @default(uuid())
  deviceId       String
  mediaId        String
  playedAt       DateTime @default(now())
  durationPlayed Int
  completed      Boolean  @default(false)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  media  Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([deviceId, playedAt(sort: Desc)])
  @@index([mediaId, playedAt(sort: Desc)])
  @@index([playedAt(sort: Desc)])
  @@map("playback_logs")
}

model DeviceHealth {
  id               String   @id @default(uuid())
  deviceId         String
  cpuUsage         Float?
  memoryUsage      Float?
  storageTotal     BigInt?
  storageUsed      BigInt?
  networkType      String?
  isOnline         Boolean  @default(true)
  ipAddress        String?
  macAddress       String?
  heapMemory       BigInt?
  networkConnected Boolean?
  processCpuPercent Float?
  wanIp            String?
  reportedAt       DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, reportedAt(sort: Desc)])
  @@map("device_health")
}

model DeviceComment {
  id             String   @id @default(uuid())
  deviceId       String
  organizationId String
  userId         String?
  userName       String?
  comment        String
  createdAt      DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt(sort: Desc)])
  @@map("device_comments")
}

// ─────────────────────────────────────────────────────────────────────────────
//  SYNC GROUPS
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  address         String?
  contact         String?
  openDate        DateTime?
  closeDate       DateTime?
  playlistId      String?
  startEpoch      BigInt?   // Unix ms khi bắt đầu phát, null = dừng
  totalDurationMs Int?      // tổng duration playlist (ms), cached lúc Start
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playlist     Playlist?    @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  devices      Device[]

  @@index([organizationId])
  @@map("stores")
}

// ─────────────────────────────────────────────────────────────────────────────
//  LICENSE
// ─────────────────────────────────────────────────────────────────────────────

model DeviceLicense {
  id                      String   @id @default(uuid())
  deviceId                String   @unique
  organizationId          String
  packageType             String   // '12M' | '24M' | '36M'
  activatedAt             DateTime @default(now())
  expiresAt               DateTime
  activatedById           String?
  activatedByName         String?
  transferredFromDeviceId String?

  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("device_licenses")
}

model LicenseHistory {
  id              String   @id @default(uuid())
  deviceId        String?
  deviceName      String?
  organizationId  String
  action          String   // ASSIGN | TRANSFER | ADJUST_EXPIRY | REVOKE | EDIT_POOL
  detail          Json?
  performedById   String?
  performedByName String?
  createdAt       DateTime @default(now())

  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("license_history")
}

model PurchaseRequest {
  id               String    @id @default(uuid())
  organizationId   String
  requestedById    String?
  requestedByName  String?
  packageType      String    // '12M' | '24M' | '36M'
  quantity         Int
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note             String?
  adminNote        String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("purchase_requests")
}
