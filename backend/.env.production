# Storage — đường dẫn trong container
STORAGE_ROOT=/app/storage
UPLOAD_TEMP_DIR=/app/storage/temp
MEDIA_DIR=/app/storage/media
THUMBNAIL_DIR=/app/storage/thumbnails

# Upload limits
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=50
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# CORS
CORS_ORIGINS=https://dms.saigontech.net

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Nginx X-Accel-Redirect
NGINX_ACCEL=true
NGINX_ACCEL_PREFIX=/internal/storage

