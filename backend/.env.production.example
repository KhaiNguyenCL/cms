# =============================================================================
#  .env.production.example — copy to .env and fill in real values
#
#  Generate JWT secrets:
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================

# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SERVER_URL=https://your-domain.com

# Database
DATABASE_URL=postgresql://cms_prod:CHANGE_ME@127.0.0.1:5432/signage_cms?sslmode=disable&schema=public

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# JWT — generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_REFRESH_EXPIRES_IN=30d

# Storage (absolute path on server)
STORAGE_ROOT=/cms/storage
UPLOAD_TEMP_DIR=/cms/storage/temp
MEDIA_DIR=/cms/storage/media
THUMBNAIL_DIR=/cms/storage/thumbnails

# Nginx X-Accel-Redirect (serve media via Nginx instead of Node.js)
NGINX_ACCEL=true
NGINX_ACCEL_PREFIX=/internal/storage

# Upload limits
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=50
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# CORS — only allow your production domain
CORS_ORIGINS=https://your-domain.com

# Rate limiting (higher limit for production with many devices)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=500

# Logging
LOG_LEVEL=info
